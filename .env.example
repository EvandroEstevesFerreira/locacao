# ============================================================================
# Loca — variáveis de ambiente. Copie para .env.local e preencha.
# ============================================================================

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role) — usada apenas em rotas de servidor/cron. NUNCA no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Fase 5 — envio de e-mails de aviso)
RESEND_API_KEY=
# Remetente verificado no Resend (ex.: "Locações Sistenge <alertas@sistenge.com>")
EMAIL_FROM=
# Caixa que recebe as respostas. O remetente é automação e ninguém o lê — sem
# isto, quem responde um aviso de vencimento fala com o vazio.
EMAIL_REPLY_TO=

# --- Teste interno de e-mail -------------------------------------------------
# Ligado (1), NENHUM e-mail chega a destinatário real: todos são desviados para
# EMAIL_TESTE_DESTINO e o assunto ganha o prefixo "[TESTE -> quem receberia]".
# O cron de vencimentos também para de gravar em notificacao_log, para que o
# teste não marque como enviado um aviso que o destinatário real nunca recebeu.
# Ligar sem preencher o destino BLOQUEIA o envio — nunca cai para os reais.
# Para lançar: apague EMAIL_MODO_TESTE.
EMAIL_MODO_TESTE=
# Um ou mais endereços, separados por vírgula, ponto-e-vírgula ou linha.
EMAIL_TESTE_DESTINO=

# Segredo do Vercel Cron (Fase 5) — protege a rota /api/cron/*
CRON_SECRET=

# URL pública do app (usada em e-mails e links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Quem recebe o RESUMO dos termos emitidos sem assinatura do funcionario.
# Aceita varios, separados por virgula, ponto-e-virgula ou linha. Vazio = ninguem
# recebe o resumo (a cobranca ao funcionario continua saindo).
EMAIL_RESUMO_TERMOS=

# --- Mega (ERP do contas a pagar) -------------------------------------------
# O cron diário /api/cron/mega copia para o Loca o que o Mega respondeu sobre
# pagamentos. Ver a seção "Pagamentos no Mega" do AGENTS.md.
#
# FAIL-CLOSED: faltando qualquer uma das três, a sincronização não roda.
# E ela só toca as organizações com linha ATIVA em `mega_sync` — subir as
# variáveis, sozinho, não faz o Loca chamar o ERP.
#
# O TENANT É SEGREDO tanto quanto a senha (é um GUID). Marque as três como
# "Sensitive" na Vercel.
#
# ATENÇÃO: a conta de API é compartilhada com o projeto Financeiro e já foi
# bloqueada uma vez por autenticação encadeada. Nunca chame a API em laço.
MEGA_TENANT=
MEGA_USER=
MEGA_PASSWORD=
